<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ 包月计费明细 ============ -->
    <record id="view_machine_billing_line_list" model="ir.ui.view">
        <field name="name">machine.billing.line.list</field>
        <field name="model">machine.billing.line</field>
        <field name="arch" type="xml">
            <list string="包月计费明细">
                <field name="period_month"/>
                <field name="partner_id"/>
                <field name="machine_no"/>
                <field name="monthly_fee"/>
                <field name="total_days"/>
                <field name="active_days"/>
                <field name="holiday_days"/>
                <field name="billable_days"/>
                <field name="amount" sum="合计"/>
                <field name="invoice_id"/>
            </list>
        </field>
    </record>

    <record id="view_machine_billing_line_pivot" model="ir.ui.view">
        <field name="name">machine.billing.line.pivot</field>
        <field name="model">machine.billing.line</field>
        <field name="arch" type="xml">
            <pivot string="包月收入统计">
                <field name="period_month" type="row" interval="month"/>
                <field name="partner_id" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_machine_billing_line_search" model="ir.ui.view">
        <field name="name">machine.billing.line.search</field>
        <field name="model">machine.billing.line</field>
        <field name="arch" type="xml">
            <search string="包月计费明细">
                <field name="period_month"/>
                <field name="partner_id"/>
                <field name="machine_id"/>
                <filter name="filter_uninvoiced" string="未开票" domain="[('invoice_id', '=', False)]"/>
                <separator/>
                <filter name="group_by_partner" string="按客户" context="{'group_by': 'partner_id'}"/>
                <filter name="group_by_machine" string="按机台" context="{'group_by': 'machine_id'}"/>
                <filter name="group_by_month" string="按月份" context="{'group_by': 'period_month:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_machine_billing_line" model="ir.actions.act_window">
        <field name="name">包月计费明细</field>
        <field name="res_model">machine.billing.line</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">还没有计费明细</p>
            <p>用「批量生成包月账单」按月份生成，会自动按当月天数与放假天数折算。</p>
        </field>
    </record>

    <!-- ============ 批量生成向导 ============ -->
    <record id="view_machine_monthly_billing_wizard_form" model="ir.ui.view">
        <field name="name">machine.monthly.billing.wizard.form</field>
        <field name="model">machine.monthly.billing.wizard</field>
        <field name="arch" type="xml">
            <form string="批量生成包月账单">
                <group>
                    <group>
                        <field name="period_month"/>
                        <field name="holiday_days"/>
                        <field name="create_invoice"/>
                    </group>
                    <group>
                        <field name="partner_ids" widget="many2many_tags"
                               placeholder="留空 = 所有包月客户"/>
                        <field name="line_count"/>
                        <field name="preview_amount"/>
                    </group>
                </group>
                <div class="text-muted">
                    计算方式：应收 = 包月单价 × (实际激活天数 − 放假天数) ÷ 当月实际天数。
                    中途加减机按包月生效 / 结束日期自动折算；当月天数取 28 / 30 / 31（不是固定 30）。
                </div>
                <footer>
                    <button name="action_generate" type="object" string="生成账单" class="btn-primary"/>
                    <button string="取消" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_machine_monthly_billing_wizard" model="ir.actions.act_window">
        <field name="name">批量生成包月账单</field>
        <field name="res_model">machine.monthly.billing.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_machine_billing_wizard" name="批量生成包月账单"
              parent="menu_machine_repair_root"
              action="action_machine_monthly_billing_wizard" sequence="50"/>
    <menuitem id="menu_machine_billing_line" name="包月计费明细"
              parent="menu_machine_repair_root"
              action="action_machine_billing_line" sequence="60"/>
</odoo>

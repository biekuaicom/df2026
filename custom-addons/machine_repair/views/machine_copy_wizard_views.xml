<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_machine_copy_wizard_form" model="ir.ui.view">
        <field name="name">machine.copy.wizard.form</field>
        <field name="model">machine.copy.wizard</field>
        <field name="arch" type="xml">
            <form string="批量复制机台">
                <group>
                    <group>
                        <field name="source_machine_id" readonly="1" options="{'no_create': True}"/>
                        <field name="target_partner_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="count"/>
                        <field name="include_sn"/>
                    </group>
                </group>
                <div class="text-muted">
                    新机台编号按样板机编号末尾数字递增（M-001 → M-002、M-003…），
                    其它字段（客户、机型、包月单价、器件基线）全部沿用样板机。
                    默认不复制 SN。
                </div>
                <footer>
                    <button name="action_copy" type="object" string="开始复制" class="btn-primary"/>
                    <button string="取消" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_machine_copy_wizard" model="ir.actions.act_window">
        <field name="name">批量复制机台</field>
        <field name="res_model">machine.copy.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_source_machine_id': active_id}</field>
    </record>
</odoo>

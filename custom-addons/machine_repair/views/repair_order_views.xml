<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ 看板：紧急度高亮 + 置顶排序 + 救援标识 ============ -->
    <record id="view_repair_order_kanban_machine_repair" model="ir.ui.view">
        <field name="name">repair.order.kanban.machine_repair</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_kanban"/>
        <field name="arch" type="xml">
            <!-- 加急和快到期的永远排在最前 -->
            <xpath expr="//kanban" position="attributes">
                <attribute name="default_order">urgency_sequence, deadline_datetime</attribute>
            </xpath>
            <!-- 卡片整体边框：超时接力=金、加急=红、紧急=橙 -->
            <xpath expr="//t[@t-name='card']/div[1]" position="attributes">
                <attribute name="t-attf-class">row #{record.state.raw_value === 'timeout_alert' ? 'border border-2 border-warning bg-warning-light' : (record.urgency_level.raw_value === 'emergency' ? 'border border-2 border-danger' : (record.urgency_level.raw_value === 'urgent' ? 'border border-2 border-warning' : ''))}</attribute>
            </xpath>
            <!-- 紧急度徽标 / 超期 / 可接力 / 师傅 / 期限 -->
            <xpath expr="//t[@t-name='card']/div[1]" position="inside">
                <div class="col-12 d-flex align-items-center gap-2 mt-1">
                    <field name="urgency_level" widget="badge"
                           decoration-danger="urgency_level == 'emergency'"
                           decoration-warning="urgency_level == 'urgent'"
                           decoration-info="urgency_level == 'normal'"/>
                    <field name="deadline_state" widget="badge"
                           decoration-danger="deadline_state == 'overdue'"/>
                    <span t-if="record.state.raw_value == 'timeout_alert'" class="badge text-bg-warning">可接力</span>
                    <span t-if="record.technician_id.raw_value" class="text-muted small">
                        <field name="technician_id"/>
                    </span>
                    <span class="text-muted small ms-auto">
                        <field name="deadline_datetime" widget="date"/>
                    </span>
                </div>
            </xpath>
        </field>
    </record>

    <!-- ============ 表单：调度信息 + 抢单/退单/接力按钮 ============ -->
    <record id="view_repair_order_form_machine_repair" model="ir.ui.view">
        <field name="name">repair.order.form.machine_repair</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_publish" type="object" string="发布到大厅" class="btn-primary"
                        invisible="state not in ('draft', 'timeout_alert')"/>
                <button name="action_claim" type="object" string="抢单" class="btn-primary"
                        invisible="not claimable"/>
                <button name="action_release" type="object" string="退单" class="btn-secondary"
                        invisible="not technician_id"/>
                <button name="action_relay" type="object" string="转接力" class="btn-secondary"
                        invisible="not technician_id"/>
                <button name="action_secondary_complete" type="object" string="接力完工" class="btn-secondary"
                        invisible="state != 'timeout_alert'"/>
                <button name="action_reset_modify_count" type="object" string="重置修改次数"
                        class="btn-secondary" groups="base.group_system"
                        invisible="not modify_count"/>
                <button name="action_create_board_qr" type="object" string="生成二维码"
                        class="btn-secondary" invisible="board_qr_id or not partner_id"/>
                <button name="action_load_extra_parts" type="object" string="带出另计维修"
                        class="btn-secondary" invisible="not machine_id"/>
                <button name="action_ship_orders" type="object" string="发货（快递单号 + 包装照片）"
                        class="btn-primary"
                        invisible="state not in ('done', 'secondary_completed') or shipped"/>
                <button name="action_open_test_delete" type="object" string="作废并删除测试单"
                        groups="base.group_system" class="btn-danger"/>
            </xpath>
            <xpath expr="//header/field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,pending_claim,confirmed,timeout_alert,done,secondary_completed</attribute>
            </xpath>
            <!-- 维修服务行：显示对应电路板与自定义单价（过保维修按台账单价收费） -->
            <xpath expr="//field[@name='repair_service_line_ids']/list" position="inside">
                <field name="board_product_id" optional="show"/>
                <field name="price_unit" invisible="parent.under_warranty"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="调度信息">
                    <group>
                        <field name="urgency_level"/>
                        <field name="urgency_days"/>
                        <field name="deadline_datetime"/>
                        <field name="is_overdue" invisible="not is_overdue"/>
                    </group>
                    <group>
                        <field name="technician_id"/>
                        <field name="claimed_at" invisible="not claimed_at"/>
                        <field name="relay_count" invisible="not relay_count"/>
                        <field name="relay_reason" placeholder="退单或转接力时填写原因"/>
                    </group>
                    <group>
                        <field name="board_qr_id" options="{'no_create': True}"/>
                        <field name="scan_code" placeholder="扫码枪扫一下，或粘贴 MR1;QR=... 内容"/>
                        <button name="action_resolve_scan" type="object" string="识别二维码"
                                class="btn-link" colspan="2" invisible="not scan_code"/>
                        <field name="qr_warranty_state" invisible="not board_qr_id"/>
                        <field name="extra_charge_price"/>
                        <field name="warranty_months"/>
                        <field name="machine_id" options="{'no_create': True}"/>
                        <field name="is_rework" invisible="not is_rework"/>
                        <field name="previous_repair_count" invisible="not machine_id"/>
                        <field name="repair_round" invisible="not machine_id"/>
                        <field name="modify_count" invisible="not modify_count"/>
                    </group>
                </group>
                <!-- 发货信息：快递单号与包装照片都是售后查证的依据 -->
                <group string="发货信息">
                    <group>
                        <field name="ship_status" widget="badge"
                               decoration-success="ship_status == 'shipped'"
                               decoration-warning="ship_status == 'unshipped'"/>
                        <field name="shipment_id"/>
                        <field name="tracking_no"/>
                    </group>
                    <group>
                        <field name="ship_date"/>
                        <field name="ship_photo_count"/>
                        <field name="warranty_start_pending"/>
                    </group>
                </group>
                <!-- 手机端录入的故障信息：以前表单里根本没有这些字段，
                     在后台打开工单就看不到「错误代码 / 故障描述 / 分析 / 过程」，
                     容易被当成“保存后信息丢了”。 -->
                <group string="故障信息（手机端录入）">
                    <group>
                        <field name="error_code"/>
                        <field name="fault_category_id"/>
                        <field name="fault_description" placeholder="故障描述（手机端「故障描述」）"/>
                        <field name="solution" placeholder="处理方式"/>
                    </group>
                    <group>
                        <field name="analysis_note" placeholder="故障分析判断"/>
                        <field name="repair_process" placeholder="维修过程"/>
                        <field name="measure_note" placeholder="电气测量记录"/>
                        <field name="video_count"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- ============ 列表：紧急度徽标 + 期限 + 师傅 ============ -->
    <record id="view_repair_order_tree_machine_repair" model="ir.ui.view">
        <field name="name">repair.order.tree.machine_repair</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-danger">urgency_level == 'emergency' or state == 'timeout_alert'</attribute>
                <attribute name="decoration-warning">urgency_level == 'urgent'</attribute>
                <attribute name="default_order">urgency_sequence, deadline_datetime</attribute>
            </xpath>
            <xpath expr="//list" position="inside">
                <field name="urgency_level" widget="badge" optional="show"
                       decoration-danger="urgency_level == 'emergency'"
                       decoration-warning="urgency_level == 'urgent'"/>
                <field name="deadline_datetime" optional="show"/>
                <field name="technician_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- ============ 搜索：大厅常用过滤与分组 ============ -->
    <record id="view_repair_order_filter_machine_repair" model="ir.ui.view">
        <field name="name">repair.order.search.machine_repair</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="filter_pending_claim" string="待抢单"
                        domain="[('state', '=', 'pending_claim')]"/>
                <filter name="filter_timeout" string="超时接力"
                        domain="[('state', '=', 'timeout_alert')]"/>
                <filter name="filter_mine" string="我抢的"
                        domain="[('technician_id', '=', uid)]"/>
                <filter name="filter_emergency" string="加急"
                        domain="[('urgency_level', '=', 'emergency')]"/>
                <separator/>
                <filter name="filter_unshipped" string="未发货"
                        domain="[('state', 'in', ['done', 'secondary_completed']), ('shipment_id', '=', False)]"/>
                <filter name="filter_shipped" string="已发货"
                        domain="[('shipment_id', '!=', False)]"/>
                <separator/>
                <filter name="group_by_urgency" string="紧急度"
                        context="{'group_by': 'urgency_level'}"/>
                <filter name="group_by_technician" string="维修师傅"
                        context="{'group_by': 'technician_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- ============ 工单大厅 ============
         分栏菜单：全部 / 待抢单 / 维修中 / 超时接力 / 已完工 / 已开票。
         每个分栏是一个独立 action（各自带 domain），按钮挂在下面的大厅列表视图上。
         注意加载顺序：列表视图 -> action（引用 view_id）-> 再给列表加 header 按钮
         （按钮里引用 action 的 xmlid，所以必须排在 action 之后，否则 xmlid 还不存在）。 -->
    <record id="view_repair_hall_list" model="ir.ui.view">
        <field name="name">repair.order.hall.list</field>
        <field name="model">repair.order</field>
        <field name="arch" type="xml">
            <list string="工单大厅"
                  decoration-danger="urgency_level == 'emergency' or state == 'timeout_alert'"
                  decoration-warning="urgency_level == 'urgent' or state == 'pending_claim'"
                  default_order="urgency_sequence, deadline_datetime">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="machine_id"/>
                <field name="board_qr_id" optional="hide"/>
                <field name="urgency_level" widget="badge" optional="show"
                       decoration-danger="urgency_level == 'emergency'"
                       decoration-warning="urgency_level == 'urgent'"/>
                <field name="deadline_datetime" optional="show"/>
                <field name="technician_id" optional="show"/>
                <field name="invoice_ids" optional="hide"/>
                <field name="state" column_invisible="True"/>
                <field name="ship_status" widget="badge" optional="show"
                       decoration-success="ship_status == 'shipped'"
                       decoration-warning="ship_status == 'unshipped'"/>
                <field name="tracking_no" optional="show"/>
                <field name="state_display" widget="badge" optional="show"
                       decoration-success="state in ('done', 'secondary_completed')"
                       decoration-info="state == 'confirmed'"
                       decoration-warning="state in ('pending_claim', 'timeout_alert')"
                       decoration-muted="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="action_repair_hall" model="ir.actions.act_window">
        <field name="name">工单大厅 · 全部</field>
        <field name="res_model">repair.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="view_repair_hall_list"/>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">工单大厅</p>
            <p>新建维修单后点「发布到大厅」，师傅在这里抢单；
               超期未完成的工单会被每小时巡检自动转为「超时接力」并高亮。
               上面的分栏可以只看某一类工单。</p>
        </field>
    </record>

    <record id="action_repair_hall_pending" model="ir.actions.act_window">
        <field name="name">工单大厅 · 待抢单</field>
        <field name="res_model">repair.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="view_repair_hall_list"/>
        <field name="domain">[('state', '=', 'pending_claim')]</field>
    </record>

    <record id="action_repair_hall_repairing" model="ir.actions.act_window">
        <field name="name">工单大厅 · 维修中</field>
        <field name="res_model">repair.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="view_repair_hall_list"/>
        <field name="domain">[('state', '=', 'confirmed')]</field>
    </record>

    <record id="action_repair_hall_timeout" model="ir.actions.act_window">
        <field name="name">工单大厅 · 超时接力</field>
        <field name="res_model">repair.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="view_repair_hall_list"/>
        <field name="domain">[('state', '=', 'timeout_alert')]</field>
    </record>

    <record id="action_repair_hall_done" model="ir.actions.act_window">
        <field name="name">工单大厅 · 已完工</field>
        <field name="res_model">repair.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="view_repair_hall_list"/>
        <field name="domain">[('state', 'in', ['done', 'secondary_completed'])]</field>
        <field name="context">{'default_order': 'write_date desc'}</field>
    </record>

    <record id="action_repair_hall_invoiced" model="ir.actions.act_window">
        <field name="name">工单大厅 · 已开票</field>
        <field name="res_model">repair.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="view_repair_hall_list"/>
        <field name="domain">[('invoice_ids', '!=', False)]</field>
    </record>

    <!-- 发货提醒：已完工但还没发货的工单（手机端「消息 → 发货」看的是同一批数据） -->
    <record id="action_repair_ship_pending" model="ir.actions.act_window">
        <field name="name">待发货工单</field>
        <field name="res_model">repair.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_repair_hall_list"/>
        <field name="domain">[('state', 'in', ['done', 'secondary_completed']),
                             ('shipment_id', '=', False)]</field>
        <field name="context">{'default_order': 'write_date asc'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">没有待发货的工单</p>
            <p>已完工的工单会出现在这里。勾选要一起寄出的几张单，点「合并发货」：
               扫/填一个快递单号、拍包装照片，就能合并成一张发货单。</p>
        </field>
    </record>

    <!-- 大厅列表上的分栏菜单按钮（extension：凡是用到这个列表视图都会出现） -->
    <record id="view_repair_hall_list_menu" model="ir.ui.view">
        <field name="name">repair.order.hall.list.menu</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="view_repair_hall_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="%(action_repair_hall)d" type="action" string="全部"
                            display="always" class="btn-secondary"/>
                    <button name="%(action_repair_hall_pending)d" type="action" string="待抢单"
                            display="always" class="btn-secondary"/>
                    <button name="%(action_repair_hall_repairing)d" type="action" string="维修中"
                            display="always" class="btn-secondary"/>
                    <button name="%(action_repair_hall_timeout)d" type="action" string="超时接力"
                            display="always" class="btn-secondary"/>
                    <button name="%(action_repair_hall_done)d" type="action" string="已完工"
                            display="always" class="btn-secondary"/>
                    <button name="%(action_repair_hall_invoiced)d" type="action" string="已开票"
                            display="always" class="btn-secondary"/>
                    <button name="action_ship_orders" type="object" string="合并发货"
                            display="always" class="btn-primary"/>
                    <button name="action_open_test_delete" type="object" string="作废并删除测试单"
                            display="always" groups="base.group_system" class="btn-danger"/>
                </header>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_repair_hall" name="工单大厅"
              parent="menu_machine_repair_root"
              action="action_repair_hall" sequence="20"
              groups="stock.group_stock_user"/>
</odoo>

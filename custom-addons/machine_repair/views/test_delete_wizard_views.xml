<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 管理员：作废并删除测试工单（二次确认 + 自动备份） -->
    <record id="view_machine_repair_test_delete_form" model="ir.ui.view">
        <field name="name">machine.repair.test.delete.form</field>
        <field name="model">machine.repair.test.delete</field>
        <field name="arch" type="xml">
            <form string="作废并删除测试单">
                <div class="alert alert-warning" role="alert" style="margin-bottom:12px">
                    <b>删除后不可恢复。</b><br/>
                    确认后系统会先把工单的全部字段、维修服务行、完工快照、聊天记录、视频文件
                    导出成 JSON / 视频文件，再取消并删除记录。<br/>
                    正式业务单据请走「退单 / 取消」，不要用这个功能。
                </div>
                <group>
                    <field name="order_summary" readonly="1"/>
                    <field name="backup_dir" readonly="1"/>
                </group>
                <field name="order_ids" invisible="1"/>
                <field name="confirmed"/>
                <footer>
                    <button name="action_confirm" type="object" string="确认作废并删除" class="btn-danger"/>
                    <button string="取消" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_machine_base_template_list" model="ir.ui.view">
        <field name="name">machine.base.template.list</field>
        <field name="model">machine.base.template</field>
        <field name="arch" type="xml">
            <list string="机型标准模板">
                <field name="code"/>
                <field name="name"/>
                <field name="line_count"/>
                <field name="note" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_machine_base_template_form" model="ir.ui.view">
        <field name="name">machine.base.template.form</field>
        <field name="model">machine.base.template</field>
        <field name="arch" type="xml">
            <form string="机型标准模板">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="如：喷水织机" required="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="可选"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="line_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="专属电路板清单" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"
                                           options="{'no_create': False}"
                                           context="{'machine_repair_board_default': True}"/>
                                    <field name="qty"/>
                                    <field name="note"/>
                                </list>
                            </field>
                            <div class="text-muted mt-2">
                                提示：只有产品类别勾选了「专属电路板类目」的产品才能选进来；
                                需要 SN 管控的板件，请同时把该产品的「追溯」设为「按唯一序列号」。
                            </div>
                        </page>
                        <page string="说明" name="note_page">
                            <field name="note" placeholder="维修要点、常见故障等"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_machine_base_template_search" model="ir.ui.view">
        <field name="name">machine.base.template.search</field>
        <field name="model">machine.base.template</field>
        <field name="arch" type="xml">
            <search string="机型标准模板">
                <field name="name"/>
                <field name="code"/>
                <filter name="filter_archived" string="已归档"
                        domain="[('active', '=', False)]"/>
                <filter name="group_by_active" string="启用状态"
                        context="{'group_by': 'active'}"/>
            </search>
        </field>
    </record>

    <record id="action_machine_base_template" model="ir.actions.act_window">
        <field name="name">机型标准模板</field>
        <field name="res_model">machine.base.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">建立第一个机型标准模板</p>
            <p>机型模板定义某类织机的专属电路板基线，阶段 2 会据此生成客户机台台账。</p>
        </field>
    </record>
</odoo>

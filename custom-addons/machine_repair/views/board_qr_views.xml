<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_machine_board_qr_list" model="ir.ui.view">
        <field name="name">machine.board.qr.list</field>
        <field name="model">machine.board.qr</field>
        <field name="arch" type="xml">
            <list string="电路板二维码">
                <field name="name"/>
                <field name="source" widget="badge"
                       decoration-info="source == 'generated'"
                       decoration-success="source == 'oem'"/>
                <field name="partner_id"/>
                <field name="machine_no"/>
                <field name="product_id"/>
                <field name="sn" optional="show"/>
                <field name="created_on"/>
                <field name="warranty_state" widget="badge" optional="show"
                       decoration-success="warranty_state == 'active'"
                       decoration-danger="warranty_state == 'expired'"/>
                <field name="monthly_start_date" optional="hide"/>
                <field name="repair_count"/>
                <field name="state" widget="badge" decoration-danger="state == 'scrapped'"/>
            </list>
        </field>
    </record>

    <record id="view_machine_board_qr_form" model="ir.ui.view">
        <field name="name">machine.board.qr.form</field>
        <field name="model">machine.board.qr</field>
        <field name="arch" type="xml">
            <form string="电路板二维码">
                <header>
                    <button name="action_mark_scrapped" type="object" string="标记报废"
                            class="btn-secondary" invisible="state == 'scrapped'"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,scrapped"/>
                </header>
                <sheet>
                    <field name="qr_image" widget="image" class="oe_avatar"
                           options="{'preview_image': 'qr_image'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="source"/>
                            <field name="partner_id"/>
                            <field name="machine_id"/>
                            <field name="machine_no"/>
                        </group>
                        <group>
                            <field name="product_id"/>
                            <field name="sn"/>
                            <field name="created_on"/>
                            <field name="digest"/>
                            <field name="repair_count"/>
                        </group>
                    </group>
                    <group string="包月与保修">
                        <group>
                            <field name="monthly_start_date"/>
                            <field name="monthly_end_date"/>
                        </group>
                        <group>
                            <field name="warranty_months"/>
                            <field name="warranty_end_date"/>
                            <field name="warranty_state" widget="badge"
                                   decoration-success="warranty_state == 'active'"
                                   decoration-danger="warranty_state == 'expired'"/>
                        </group>
                    </group>
                    <group string="二维码内容（扫码即可读出）">
                        <field name="payload" nolabel="1" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="电路板照片" name="photos">
                            <group>
                                <group>
                                    <field name="front_photo_count"/>
                                    <field name="back_photo_count"/>
                                </group>
                                <group>
                                    <field name="has_required_photos"/>
                                </group>
                            </group>
                            <div class="text-muted" style="margin-bottom:8px">
                                业务要求：每块板至少要有<b>正面 + 反面</b>各一张，否则工单不允许发布到大厅；
                                之后可以继续加拍任意多张「局部特写」。
                            </div>
                            <field name="photo_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="kind"/>
                                    <field name="image" widget="image" options="{'size': [70, 70]}"/>
                                    <field name="note"/>
                                    <field name="taken_by"/>
                                    <field name="taken_at"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group>
                        <field name="note" placeholder="补码原因、原厂码磨损情况、客户变更说明等"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_machine_board_qr_search" model="ir.ui.view">
        <field name="name">machine.board.qr.search</field>
        <field name="model">machine.board.qr</field>
        <field name="arch" type="xml">
            <search string="电路板二维码">
                <field name="name"/>
                <field name="sn"/>
                <field name="partner_id"/>
                <field name="machine_id"/>
                <filter name="filter_generated" string="系统生成" domain="[('source', '=', 'generated')]"/>
                <filter name="filter_oem" string="原厂码" domain="[('source', '=', 'oem')]"/>
                <filter name="filter_active" string="有效" domain="[('state', '=', 'active')]"/>
                <filter name="filter_warranty_active" string="保修中"
                        domain="[('warranty_end_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="filter_warranty_expired" string="已过保"
                        domain="[('warranty_end_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="group_by_partner" string="按客户" context="{'group_by': 'partner_id'}"/>
                <filter name="group_by_machine" string="按机台" context="{'group_by': 'machine_id'}"/>
                <filter name="group_by_product" string="按板型" context="{'group_by': 'product_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_machine_board_qr" model="ir.actions.act_window">
        <field name="name">电路板二维码</field>
        <field name="res_model">machine.board.qr</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">还没有电路板二维码</p>
            <p>包月客户在「客户机台台账」录板件时会自动建码；
               外来维修在工单上点「生成二维码」即可现场补码。
               原厂码能扫出来就填「原厂 SN」并选来源「原厂二维码」，原厂信息模糊时用系统生成的码。</p>
        </field>
    </record>

    <menuitem id="menu_machine_board_qr" name="电路板二维码"
              parent="menu_machine_repair_base"
              action="action_machine_board_qr" sequence="50"/>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 维修快照编号 -->
        <record id="seq_repair_case" model="ir.sequence">
            <field name="name">维修快照</field>
            <field name="code">repair.case</field>
            <field name="prefix">CASE/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- 阶段 5：经验库每日聚合（把新快照归并到【机型 + 故障分类】） -->
        <record forcecreate="True" id="ir_cron_experience_aggregate" model="ir.cron">
            <field name="name">机台维修：经验库每日聚合</field>
            <field name="model_id" ref="model_repair_experience"/>
            <field name="state">code</field>
            <field name="code">model._cron_aggregate()</field>
            <field eval="True" name="active"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="priority">6</field>
        </record>
    </data>
</odoo>
